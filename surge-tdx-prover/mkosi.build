#!/bin/bash
set -euxo pipefail

source scripts/build_rust_package.sh
source scripts/build_dotnet_package.sh
source scripts/make_git_package.sh

NETHERMIND_VERSION="1.32.3"
LIGHTHOUSE_VERSION="v7.0.1"
TAIKO_CLIENT_VERSION="main-pacaya-v1.6.1"
RAIKO_VERSION="feat/tdx"
TDX_INIT_VERSION="v0.1.1"
SSH_PUBKEY_SERVER_VERSION="multi-key"
CVM_REVERSE_PROXY_VERSION="v0.1.7"

build_dotnet_package \
    "nethermind" \
    "$NETHERMIND_VERSION" \
    "https://github.com/NethermindEth/nethermind.git" \
    "$NETHERMIND_BINARY" \
    "src/Nethermind/Nethermind.Runner" \
    ""

build_rust_package \
    "lighthouse" \
    "$LIGHTHOUSE_VERSION" \
    "https://github.com/sigp/lighthouse.git" \
    "$LIGHTHOUSE_BINARY" \
    "modern" \
    "-l z -l zstd -l snappy" \
    ""

make_git_package \
    "taiko-client" \
    "$TAIKO_CLIENT_VERSION" \
    "https://github.com/NethermindEth/surge-taiko-mono/" \
    "cd packages/taiko-client && make build" \
    "packages/taiko-client/bin/taiko-client:/usr/bin/taiko-client"

build_rust_package \
    "raiko-host:raiko" \
    "$RAIKO_VERSION" \
    "https://github.com/NethermindEth/raiko.git" \
    "$RAIKO_BINARY" \
    "tdx,raiko-tasks/in-memory" \
    "" \
    "raiko-host"

make_git_package \
    "tdx-init" \
    "$TDX_INIT_VERSION" \
    "https://github.com/flashbots/tdx-init" \
    'go build -trimpath -ldflags "-s -w -buildid=" -o ./build/tdx-init' \
    "build/tdx-init:/usr/bin/tdx-init"

make_git_package \
    "ssh-pubkey-server" \
    "$SSH_PUBKEY_SERVER_VERSION" \
    "https://github.com/flashbots/ssh-pubkey-server" \
    'go build -trimpath -ldflags "-s -w -buildid= -X github.com/flashbots/go-template/common.Version=v1.0.0" -o ./build/ssh-pubkey-server cmd/httpserver/main.go' \
    "build/ssh-pubkey-server:/usr/bin/ssh-pubkey-server"

make_git_package \
    "cvm-reverse-proxy" \
    "$CVM_REVERSE_PROXY_VERSION" \
    "https://github.com/flashbots/cvm-reverse-proxy" \
    "make build-proxy-server" \
    "build/proxy-server:/usr/bin/cvm-reverse-proxy"
