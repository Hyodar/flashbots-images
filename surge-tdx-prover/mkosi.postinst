#!/bin/bash
set -euxo pipefail

# Create users and groups
mkosi-chroot groupadd -r eth
mkosi-chroot useradd -r -s /bin/false -G eth lighthouse
mkosi-chroot useradd -r -s /bin/false -G eth nethermind
mkosi-chroot useradd -r -s /bin/false -G eth nethermind-surge
mkosi-chroot useradd -r -s /bin/false -G eth taiko-client

# Set limits for Nethermind users
sudo bash -c 'echo "nethermind soft nofile 100000" > /etc/security/limits.d/global-nofile.conf'
sudo bash -c 'echo "nethermind hard nofile 100000" >> /etc/security/limits.d/global-nofile.conf'
sudo bash -c 'echo "nethermind-surge soft nofile 100000" >> /etc/security/limits.d/global-nofile.conf'
sudo bash -c 'echo "nethermind-surge hard nofile 100000" >> /etc/security/limits.d/global-nofile.conf'

# Install services
install -m 755 services/bin/lighthouse-init "$BUILDROOT/usr/bin/"
install -m 755 services/bin/nethermind-init "$BUILDROOT/usr/bin/"
install -m 755 services/bin/nethermind-surge-init "$BUILDROOT/usr/bin/"

# Remove autogenerated ssh keys
rm -r "$BUILDROOT/etc/dropbear"
mkdir "$BUILDROOT/etc/dropbear"

# Enable services
mkdir "$BUILDROOT/etc/systemd/system/minimal.target.wants"

for service in \
    persistence-setup.service
do
    install -m 644 "services/systemd/$service" "$BUILDROOT/etc/systemd/system/$service"
    mkosi-chroot systemctl enable "$service"
    ln -sf "/etc/systemd/system/$service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/$service"
done

for service in \
    network-setup.service \
    openntpd.service \
    logrotate.service \
    wait-for-key.service \
    dropbear.service \
    ssh-pubkey-server.service \
    cvm-reverse-proxy.service \
    nethermind.service \
    nethermind-surge.service \
    lighthouse.service
do
    mkosi-chroot systemctl enable "$service"
    ln -sf "/etc/systemd/system/$service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
done

# Don't reserve port 22
mkosi-chroot systemctl disable ssh.service ssh.socket
mkosi-chroot systemctl mask ssh.service ssh.socket

# Lock the root account
mkosi-chroot passwd -l root

# Remove execute permissions from su for non-root users
chmod 700 "$BUILDROOT/bin/su"
mkosi-chroot chown root:root /bin/su
